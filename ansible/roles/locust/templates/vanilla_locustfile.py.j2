import csv
import os
import logging
from locust import HttpUser, task, between
from gevent.lock import Semaphore

# Setup logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')
logger = logging.getLogger(__name__)

# Global request counter and limits
TOTAL_REQUESTS = 0
MAX_REQUESTS = 1000
counter_lock = Semaphore()
file_lock = Semaphore()

# CSV file path (this will save in the working directory, which is /opt/locust per your service file)
csv_file_path = os.path.join(os.getcwd(), "locust_stats.csv")

# Initialize CSV file with a header if it doesn't exist
if not os.path.exists(csv_file_path):
    with open(csv_file_path, "w", newline="") as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(["Request Number", "Status Code", "Response Time (ms)"])

class HelloUser(HttpUser):
    wait_time = between(0, 0.1)

    @task
    def post_hello(self):
        global TOTAL_REQUESTS
        # Increment the global request counter safely
        with counter_lock:
            if TOTAL_REQUESTS >= MAX_REQUESTS:
                logger.info("Reached maximum of %d requests. No further requests will be sent.", MAX_REQUESTS)
                return
            TOTAL_REQUESTS += 1
            current_request = TOTAL_REQUESTS
            logger.debug("Dispatching request #%d", current_request)
        
        # Make the POST request
        response = self.client.post("/v1/fn/_/hello")
        
        # Calculate response time in milliseconds
        response_time_ms = response.elapsed.total_seconds() * 1000
        
        # Write the result to CSV immediately
        row = [current_request, response.status_code, response_time_ms]
        with file_lock:
            with open(csv_file_path, "a", newline="") as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(row)
        logger.info("Request #%d completed with status code: %d", current_request, response.status_code)
